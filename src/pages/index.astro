---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PortfolioSection from "../components/PortfolioSection.astro";
import CTA from "../components/CTA.astro";
import { getGalleryImages } from "../lib/cloudinary.js";

const [weddings, engagements, other] = await Promise.all([
  getGalleryImages("weddings", {
    limit: 3,
    defaultAlt: "Wedding photography",
    featuredTag: "home-preview",
    byFolder: true,
  }),
  getGalleryImages("engagements", {
    limit: 3,
    defaultAlt: "Engagement photography",
    featuredTag: "home-preview",
    byFolder: true,
  }),
  getGalleryImages("other", {
    limit: 3,
    featuredTag: "home-preview",
    byFolder: true,
  }),
]);
---

<Layout title="Julie Han Photography">
  <main>
    <Hero />

    <PortfolioSection
      title="Weddings"
      variant="home"
      link="/portfolio#weddings"
      images={weddings}
    />

    <PortfolioSection
      title="Engagements"
      variant="home"
      link="/portfolio#engagements"
      images={engagements}
    />

    <PortfolioSection
      title="Other"
      variant="home"
      link="/portfolio#other"
      images={other}
    />

    <CTA />
  </main>
</Layout>